# Environment Configuration for IN-Track Backend (Module 3)
NODE_ENV=development
PORT=5000

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/intrack_finance

# Module 1 Integration & Development Auth Bypass
DEV_AUTH_BYPASS=true
DEV_TEST_USER_ID=usr_test_fin_001
DEV_TEST_COMPANY_ID=cmp_test_001
DEV_TEST_ROLE=Finance Manager

# Currency and Localization
FINANCE_NORMALIZATION_CURRENCY=BDT
FINANCE_ENABLE_DEMO_CONSUMPTION=true

# Security & CORS
JWT_SECRET=finance_secure_development_key_do_not_use_in_prod
FRONTEND_ORIGIN=http://localhost:5173
